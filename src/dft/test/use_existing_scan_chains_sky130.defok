SCANCHAINS 4 ;

- chain_0
+ START PIN scan_in_0
+ ORDERED
  ff9_clk1_rising ( IN SCD ) ( OUT Q )
  ff7_clk1_rising ( IN SCD ) ( OUT Q )
  ff5_clk1_rising ( IN SCD ) ( OUT Q )
